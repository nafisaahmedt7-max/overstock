NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_hWotx_SP5Z1MBFBOAzRHiw_XtzRAxFu

# Server-only settings for portal registration and password reset emails via Brevo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=OVERSTOCK

# Local-only email capture. Set EMAIL_PROVIDER=mailpit in .env.local while testing.
# Mailpit runs locally at http://127.0.0.1:8025 and stores messages instead of delivering them.
EMAIL_PROVIDER=
MAILPIT_URL=http://127.0.0.1:8025
MAILPIT_FROM_EMAIL=no-reply@overstock.local
# Preferred current Supabase server key. Keep it private and server-side only.
SUPABASE_SECRET_KEY=
# Legacy fallback; use only if the project still uses legacy API keys.
SUPABASE_SERVICE_ROLE_KEY=

# Public customer contact channels shown on /legal/contact
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
